# Local dev run (PyCharm/IDE) — see docs/architecture for what each
# service does. Copy to .env (gitignored) and fill in real values;
# Settings (config.py) loads .env automatically, no extra tooling needed.
#
# Use a SEPARATE Telegram bot (new token from @BotFather) for local dev —
# never the prod token, or your local process and the prod pod would both
# long-poll the same token and split updates between them.
TELEGRAM_BOT_TOKEN=

# Local ephemeral Postgres/Redis (same containers/ports the test suite
# uses — see the session's own `docker start bn-test-pg bn-test-redis`).
# A dedicated Redis DB index (here: /1) keeps this separate from pytest's
# own /0 and the real cluster's Redis.
DATABASE_URL=postgresql+psycopg://postgres:test@localhost:15432/postgres
REDIS_URL=redis://localhost:16379/1

# Real cluster services, reached through a port-forward (see
# ~/bin/k.sh — kubectl runs on the homelab Windows host over SSH, so an
# extra `ssh -L <port>:localhost:<port> ...` local-forward is needed on
# top of `kubectl port-forward` to reach it from here):
#   kubectl port-forward svc/notes-embeddings 18000:8000
#   kubectl port-forward svc/notes-translate 18001:8000
#   kubectl port-forward svc/ai-proxy 18787:8787
EMBEDDINGS_URL=http://localhost:18000
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

TRANSLATE_ENABLED=true
TRANSLATE_URL=http://localhost:18001

LLM_ENABLED=true
PROXY_AI_URL=http://localhost:18787

LOG_LEVEL=DEBUG
